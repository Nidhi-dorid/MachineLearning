

import numpy as np

def s_algorithm(data, k):
   
    n_samples = data.shape[0]
    
    
    cluster_centers = data[np.random.choice(n_samples, k, replace=False)]
    
    
    cluster_assignments = np.zeros(n_samples, dtype=int)
    
    while True:
        new_cluster_assignments = np.zeros(n_samples, dtype=int)

        
        for i in range(n_samples):
            distances = np.linalg.norm(data[i] - cluster_centers, axis=1)
            new_cluster_assignments[i] = np.argmin(distances)
            
  
        if np.array_equal(cluster_assignments, new_cluster_assignments):
            break
        cluster_assignments = new_cluster_assignments

        
        for j in range(k):
            cluster_points = data[cluster_assignments == j]
            if len(cluster_points) > 0:
                cluster_centers[j] = np.mean(cluster_points, axis=0)
    return cluster_assignments



data = np.array([[1, 2], [1.5, 1.8], [5, 8], [8, 8], [1, 0.6], [9, 11]])
k = 2
cluster_assignments = s_algorithm(data, k)

print("Cluster Assignments:", cluster_assignments)
